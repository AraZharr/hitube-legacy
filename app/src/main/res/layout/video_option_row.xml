<?xml version="1.0" encoding="utf-8"?>
<!--
	A single secondary option row in the video actions bottom sheet.
	Minimum height 48dp so it is easy to tap on a small screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:minHeight="48dp"
	android:background="?attr/selectableItemBackground"
	android:clickable="true"
	android:focusable="true"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingStart="@dimen/hitube_content_padding_horizontal"
	android:paddingEnd="@dimen/hitube_content_padding_horizontal">

	<ImageView
		android:id="@+id/bottom_sheet_option_icon"
		android:layout_width="24dp"
		android:layout_height="24dp"
		android:tint="@color/hitube_on_surface" />

	<TextView
		android:id="@+id/bottom_sheet_option_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/hitube_content_padding_horizontal"
		android:layout_weight="1"
		android:ellipsize="end"
		android:maxLines="1"
		android:textAppearance="@style/HitubeBodyMedium" />

</LinearLayout>
