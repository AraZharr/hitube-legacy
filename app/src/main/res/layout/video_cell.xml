<?xml version="1.0" encoding="utf-8"?>
<!--
	HiTube Legacy — video card, fresh UI (modern Material 3 pattern):
	rounded thumbnail on top with duration / like badges overlaid,
	then title and channel metadata below. Flat — no card container,
	no gradient, no fake shadow.
	All view IDs are unchanged so the adapter code keeps working.
-->
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/top_layout"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_margin="@dimen/hitube_grid_item_margin">

	<!-- Rounded thumbnail (6dp corners, flat, no elevation). -->
	<androidx.cardview.widget.CardView
		android:id="@+id/thumbnail_card_view"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		app:cardCornerRadius="@dimen/hitube_thumbnail_corner_radius"
		app:cardElevation="0dp"
		app:cardBackgroundColor="@color/hitube_surface"
		app:cardUseCompatPadding="false"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent">

		<ImageView
			android:id="@+id/thumbnail_image_view"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:adjustViewBounds="true"
			android:src="@drawable/thumbnail_default"/>
	</androidx.cardview.widget.CardView>

	<ProgressBar
		android:id="@+id/video_position_progress_bar"
		style="?android:attr/progressBarStyleHorizontal"
		android:layout_width="0dp"
		android:layout_height="4dp"
		android:progressDrawable="@drawable/video_position_progress_bar"
		android:visibility="invisible"
		app:layout_constraintBottom_toBottomOf="@id/thumbnail_card_view"
		app:layout_constraintStart_toStartOf="@id/thumbnail_card_view"
		app:layout_constraintEnd_toEndOf="@id/thumbnail_card_view"/>

	<TextView
		android:id="@+id/thumbs_up_text_view"
		style="@style/GridMicroDetailsTextView"
		android:layout_marginStart="8dp"
		android:layout_marginLeft="8dp"
		android:layout_marginBottom="8dp"
		android:drawablePadding="5dp"
		android:text="97%"
		app:drawableLeftCompat="@drawable/ic_thumb_up"
		app:drawableStartCompat="@drawable/ic_thumb_up"
		app:layout_constraintBottom_toBottomOf="@id/thumbnail_card_view"
		app:layout_constraintStart_toStartOf="@id/thumbnail_card_view" />

	<TextView
		android:id="@+id/video_duration_text_view"
		style="@style/GridMicroDetailsTextView"
		android:layout_marginEnd="8dp"
		android:layout_marginRight="8dp"
		android:text="19:17"
		app:layout_constraintBaseline_toBaselineOf="@+id/thumbs_up_text_view"
		app:layout_constraintEnd_toEndOf="@id/thumbnail_card_view"/>

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:id="@+id/channel_layout"
		android:paddingStart="@dimen/hitube_content_padding_horizontal"
		android:paddingLeft="@dimen/hitube_content_padding_horizontal"
		android:paddingEnd="@dimen/hitube_content_padding_horizontal"
		android:paddingRight="@dimen/hitube_content_padding_horizontal"
		android:paddingTop="12dp"
		android:paddingBottom="8dp"
		app:layout_constraintTop_toBottomOf="@id/thumbnail_card_view"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent">

		<TextView
			android:id="@+id/channel_avatar_text_view"
			android:layout_width="@dimen/hitube_channel_avatar_size"
			android:layout_height="@dimen/hitube_channel_avatar_size"
			android:background="@drawable/hitube_avatar_background"
			android:gravity="center"
			android:textColor="@color/hitube_on_surface"
			android:textSize="16sp"
			android:textStyle="bold"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintStart_toStartOf="parent" />

		<TextView
			android:id="@+id/title_text_view"
			style="@style/GridTitleTextView"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_marginLeft="12dp"
			android:layout_marginEnd="8dp"
			android:layout_marginRight="8dp"
			android:maxLines="2"
			android:minLines="1"
			android:text="Title"
			android:textStyle="bold"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintStart_toEndOf="@+id/channel_avatar_text_view"
			app:layout_constraintEnd_toStartOf="@+id/options_button"/>

		<TextView
			android:id="@+id/channel_text_view"
			style="@style/GridDetailsTextView"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_marginLeft="12dp"
			android:layout_marginTop="4dp"
			android:layout_marginEnd="8dp"
			android:layout_marginRight="8dp"
			android:text="Channel"
			app:layout_constraintTop_toBottomOf="@+id/title_text_view"
			app:layout_constraintStart_toEndOf="@+id/channel_avatar_text_view"
			app:layout_constraintEnd_toStartOf="@+id/options_button"/>

		<TextView
			android:id="@+id/views_text_view"
			style="@style/GridDetailsTextView"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_marginLeft="12dp"
			android:layout_marginTop="2dp"
			android:text="199 Views"
			app:layout_constraintTop_toBottomOf="@+id/channel_text_view"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintStart_toEndOf="@+id/channel_avatar_text_view"/>

		<TextView
			android:id="@+id/separator_text_view"
			style="@style/GridDetailsTextView"
			android:layout_width="wrap_content"
			android:layout_marginStart="8dp"
			android:layout_marginLeft="8dp"
			android:text="|"
			app:layout_constraintBaseline_toBaselineOf="@+id/views_text_view"
			app:layout_constraintStart_toEndOf="@+id/views_text_view"/>

		<TextView
			android:id="@+id/publish_date_text_view"
			style="@style/GridDetailsTextView"
			android:layout_width="wrap_content"
			android:layout_marginStart="8dp"
			android:layout_marginLeft="8dp"
			android:text="x days ago"
			app:layout_constraintBaseline_toBaselineOf="@+id/views_text_view"
			app:layout_constraintStart_toEndOf="@+id/separator_text_view"/>

		<ImageButton
			android:id="@+id/options_button"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_gravity="center_vertical"
			android:background="@android:color/transparent"
			android:padding="12dp"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			app:srcCompat="@drawable/button_options"/>

	</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
