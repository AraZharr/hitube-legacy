<?xml version="1.0" encoding="utf-8"?>
<!--
	A single filter chip. The chip is visually 32dp tall; its touch target stays
	at the 48dp minimum via the Chip default minimum touch target size.
-->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/filter_chip"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:layout_marginEnd="@dimen/hitube_item_spacing"
	android:checkable="true"
	style="@style/HitubeFilterChip" />
