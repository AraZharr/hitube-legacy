<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/subs_drawer_layout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/hitube_background">


	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		tools:showIn="@layout/activity_main">


		<androidx.core.widget.NestedScrollView
			android:id="@+id/main_scroll_view"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:fillViewport="true"
			android:paddingBottom="@dimen/hitube_bottom_nav_height"
			android:clipToPadding="false"
			app:layout_behavior="@string/appbar_scrolling_view_behavior">

			<!-- Scrolling content -->

			<!-- FRAGMENTS will be placed here ... -->
			<androidx.viewpager.widget.ViewPager
				android:id="@+id/pager"
				android:layout_width="match_parent"
				android:layout_height="match_parent" />

		</androidx.core.widget.NestedScrollView>



		<com.google.android.material.appbar.AppBarLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

			<!-- TOOLBAR / ACTIONBAR -->
			<androidx.appcompat.widget.Toolbar
				android:id="@+id/toolbar"
				android:layout_width="match_parent"
				android:layout_height="?attr/actionBarSize"
				android:theme="@style/AppTheme.CustomBackground"
				app:layout_scrollFlags="scroll|enterAlways" />

			<!-- TABS — kept (but hidden) so the ViewPager wiring in MainFragment
				keeps working; navigation now lives in the bottom bar below. -->
			<com.google.android.material.tabs.TabLayout
				android:id="@+id/tab_layout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal"
				android:visibility="gone"
                app:tabMode="scrollable"
                style="@style/FixedTabs"

            />

		</com.google.android.material.appbar.AppBarLayout>

		<!-- Bottom bar: the in-app mini player (shown when a video is minimised) sits
			directly above the bottom navigation. The scroll view above gets extra bottom
			padding (see MainFragment) while the mini player is visible so no content is
			hidden behind it. The whole container lives INSIDE the CoordinatorLayout, not
			as a direct child of DrawerLayout — DrawerLayout only accepts layout_gravity
			LEFT/RIGHT/NO_GRAVITY for direct children and crashes on "bottom". -->
		<LinearLayout
			android:id="@+id/bottom_bar_container"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom"
			android:orientation="vertical">

			<!-- Mini player bar: small video surface + title + play/pause + close.
				Hidden when nothing is playing. Tapping the bar (not the buttons)
				expands back to the full player at the same position. -->
			<LinearLayout
				android:id="@+id/mini_player_bar"
				android:layout_width="match_parent"
				android:layout_height="@dimen/hitube_mini_player_height"
				android:background="@color/hitube_surface"
				android:contentDescription="@string/mini_player_expand"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:visibility="gone">

				<com.google.android.exoplayer2.ui.PlayerView
					android:id="@+id/mini_player_view"
					android:layout_width="96dp"
					android:layout_height="match_parent"
					android:layout_margin="1dp"
					app:use_controller="false" />

				<TextView
					android:id="@+id/mini_player_title"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:layout_marginEnd="4dp"
					android:layout_weight="1"
					android:ellipsize="end"
					android:maxLines="1"
					android:textColor="@color/hitube_on_surface"
					android:textSize="14sp" />

				<ImageButton
					android:id="@+id/mini_player_play_pause"
					android:layout_width="48dp"
					android:layout_height="48dp"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:contentDescription="@string/mini_player_pause"
					android:src="@drawable/ic_pause" />

				<ImageButton
					android:id="@+id/mini_player_close"
					android:layout_width="48dp"
					android:layout_height="48dp"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:contentDescription="@string/mini_player_close"
					android:src="@drawable/ic_close" />

			</LinearLayout>

			<!-- Bottom navigation: Home / Search / Library. -->
			<com.google.android.material.bottomnavigation.BottomNavigationView
				android:id="@+id/bottom_nav"
				android:layout_width="match_parent"
				android:layout_height="@dimen/hitube_bottom_nav_height"
				android:background="@color/hitube_surface"
				app:itemIconTint="@color/hitube_bottom_nav_item_color"
				app:itemTextColor="@color/hitube_bottom_nav_item_color"
				app:labelVisibilityMode="labeled"
				app:menu="@menu/bottom_nav_menu" />

		</LinearLayout>

	</androidx.coordinatorlayout.widget.CoordinatorLayout>

	<include
		android:id="@+id/subs_drawer"
		layout="@layout/subs_drawer"
		android:layout_width="240dp"
		android:layout_height="match_parent"
		android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
