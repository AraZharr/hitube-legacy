<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/subs_drawer_layout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/hitube_background">


	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		tools:showIn="@layout/activity_main">


		<androidx.core.widget.NestedScrollView
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:fillViewport="true"
			android:paddingBottom="@dimen/hitube_bottom_nav_height"
			android:clipToPadding="false"
			app:layout_behavior="@string/appbar_scrolling_view_behavior">

			<!-- Scrolling content -->

			<!-- FRAGMENTS will be placed here ... -->
			<androidx.viewpager.widget.ViewPager
				android:id="@+id/pager"
				android:layout_width="match_parent"
				android:layout_height="match_parent" />

		</androidx.core.widget.NestedScrollView>



		<com.google.android.material.appbar.AppBarLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

			<!-- TOOLBAR / ACTIONBAR -->
			<androidx.appcompat.widget.Toolbar
				android:id="@+id/toolbar"
				android:layout_width="match_parent"
				android:layout_height="?attr/actionBarSize"
				android:theme="@style/AppTheme.CustomBackground"
				app:layout_scrollFlags="scroll|enterAlways" />

			<!-- TABS — kept (but hidden) so the ViewPager wiring in MainFragment
				keeps working; navigation now lives in the bottom bar below. -->
			<com.google.android.material.tabs.TabLayout
				android:id="@+id/tab_layout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal"
				android:visibility="gone"
                app:tabMode="scrollable"
                style="@style/FixedTabs"

            />

		</com.google.android.material.appbar.AppBarLayout>

		<!-- Bottom navigation: Home / Search / Library. Sits above the content;
			the scroll view above has bottom padding equal to this bar's height
			so no content is hidden behind it (important on short screens).
			NOTE: must live INSIDE the CoordinatorLayout, not as a direct
			child of DrawerLayout — DrawerLayout only accepts layout_gravity
			LEFT/RIGHT/NO_GRAVITY for direct children and crashes on "bottom". -->
		<com.google.android.material.bottomnavigation.BottomNavigationView
			android:id="@+id/bottom_nav"
			android:layout_width="match_parent"
			android:layout_height="@dimen/hitube_bottom_nav_height"
			android:layout_gravity="bottom"
			android:background="@color/hitube_surface"
			app:itemIconTint="@color/hitube_bottom_nav_item_color"
			app:itemTextColor="@color/hitube_bottom_nav_item_color"
			app:labelVisibilityMode="labeled"
			app:menu="@menu/bottom_nav_menu" />

	</androidx.coordinatorlayout.widget.CoordinatorLayout>

	<include
		android:id="@+id/subs_drawer"
		layout="@layout/subs_drawer"
		android:layout_width="240dp"
		android:layout_height="match_parent"
		android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
